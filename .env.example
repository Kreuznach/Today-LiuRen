# 앱인토스(Apps in Toss) 기본 정보
VITE_AIT_APP_NAME=

# 보상형 광고 그룹 ID (Toss 파트너 콘솔에서 발급)
VITE_AIT_REWARDED_DETAIL_AD_GROUP_ID=ait.v2.live.13dd43c6c51f4add
VITE_AIT_REWARDED_EXTRA_QUESTION_AD_GROUP_ID=ait.v2.live.57e003203911488c
VITE_AIT_BANNER_AD_GROUP_ID=

# 참고: 광고 코드는 테스트 ID를 쓰지 않고, 항상 실제 발급된 live ID를 사용합니다.

# Supabase (MVP에서는 미사용, 추후 로그인/동기화가 필요할 때만 채운다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI 해석 API (서버 전용 — 절대 VITE_ 접두사로 클라이언트에 노출하지 않는다)
AI_API_ENDPOINT=
AI_API_SECRET=
